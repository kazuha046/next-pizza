#!/usr/bin/env bash
set -e
if [[ ! -d "/home/mrkir/Documents/Frontend/next-pizza" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/mrkir/Documents/Frontend/next-pizza")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/mrkir/Documents/Frontend/next-pizza" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/mrkir/Documents/Frontend/next-pizza/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/mrkir/Documents/Frontend/next-pizza/.envrc" "/home/mrkir/Documents/Frontend/next-pizza/.direnv"/*.rc
